{
  "name": "composia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "contracts:test": "pnpm --filter @composia/contracts test",
    "contracts:build": "pnpm --filter @composia/contracts build",
    "deploy:lukso": "pnpm --filter @composia/contracts deploy:lukso",
    "deploy:sepolia": "pnpm --filter @composia/contracts deploy:sepolia",
    "listener:dev": "pnpm --filter @composia/listener dev",
    "frontend:dev": "pnpm --filter @composia/frontend dev"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
