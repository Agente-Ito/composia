# ── Lukso testnet ────────────────────────────────────────────────────────────
LUKSO_TESTNET_RPC=https://rpc.testnet.lukso.network
MOCK_GENSYN_ADDRESS=0x...          # from .env.deployed after deploy:lukso
COMPOSIA_REGISTRY_ADDRESS=0x...   # from .env.deployed after deploy:lukso

# ── Gensyn real chain (Chain ID 685685) ───────────────────────────────────
# Set GENSYN_MODE=real to use live on-chain data instead of MockGensyn
GENSYN_MODE=mock
GENSYN_RPC=https://gensyn-testnet.g.alchemy.com/public
GENSYN_PEER_CONTRACT=0x7745a8FE4b8D2D2c3BB103F8dCae822746F35Da0

# ── Wallet (used for UP deployment + composia writes) ─────────────────────
# IMPORTANT: never commit the real key — add it only to your local .env file
DEPLOYER_PRIVATE_KEY=0x...
COMPOSIA_PRIVATE_KEY=0x...

# ── Ethereum Sepolia (for ENS subdomain + reputation state) ───────────────
# Free public RPC — no API key required:
ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
ENS_REGISTRAR_ADDRESS=0x...        # from .env.deployed after deploy:ens
REPUTATION_STATE_ADDRESS=0x...     # from .env.deployed after deploy:ens
ENS_NAME_MANAGER_ADDRESS=0x...     # from .env.deployed after deploy:ens

# ── Notifications (optional) ──────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── AXL — Gensyn P2P reputation discovery (github.com/gensyn-ai/axl) ─────
# Set AXL_ENABLED=true to serve get_score / get_peers queries over the Gensyn mesh.
# Build AXL: go build -o axl-node ./cmd/node/
# Generate key (macOS): /opt/homebrew/opt/openssl/bin/openssl genpkey -algorithm ed25519 -out private.pem
# Run node: ./axl-node --port 9002 --key-file private.pem
AXL_ENABLED=false
AXL_API=http://127.0.0.1:9002
COMPOSIA_FRONTEND_URL=http://localhost:3000
# AXL_NODE_KEY: 64-char hex public key from GET http://127.0.0.1:9002/topology → our_public_key
# After setting, run: pnpm ts-node src/axl-ens-setup.ts
AXL_NODE_KEY=
COMPOSIA_ENS_NAME=composia.eth
# Set to true to require senders to meet the on-chain verifications threshold (anti-Sybil)
AXL_REQUIRE_THRESHOLD=false
