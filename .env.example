# Wallets
DEPLOYER_PRIVATE_KEY=0x...
COMPOSIA_PRIVATE_KEY=0x...

# RPCs
LUKSO_TESTNET_RPC=https://rpc.testnet.lukso.network
ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com   # free, no API key needed

# Gensyn real chain (Chain ID 685685)
# GENSYN_MODE=real to use the real chain, GENSYN_MODE=mock (default) for local demo
GENSYN_MODE=mock
GENSYN_RPC=https://gensyn-testnet.g.alchemy.com/public
GENSYN_PEER_CONTRACT=0x7745a8FE4b8D2D2c3BB103F8dCae822746F35Da0

# Contratos desplegados (copiar desde .env.deployed después del deploy)
MOCK_GENSYN_ADDRESS=0x...
COMPOSIA_REGISTRY_ADDRESS=0x...
SYNCER_ETHEREUM_ADDRESS=0x...
REPUTATION_STATE_ADDRESS=0x...
ERC8004_REGISTRY_ADDRESS=0x...

# URL pública del frontend — debe ser estable para que KeeperHub pueda llamar los webhooks
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app
COMPOSIA_FRONTEND_URL=https://tu-proyecto.vercel.app

# Namespace offchain ENS subnames (namespace.ninja)
# 1. Lista composia.eth en namespace.ninja
# 2. Obtén el API key en el dashboard
NAMESPACE_API_KEY=
NAMESPACE_MODE=mainnet   # mainnet | sepolia (sepolia = staging.offchain-manager.namespace.ninja)

# Notificaciones (opcional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# KeeperHub — API key que KeeperHub envía como Bearer token
# Generar con: openssl rand -hex 32
COMPOSIA_API_KEY=

# AXL — Gensyn P2P reputation discovery (github.com/gensyn-ai/axl)
# Set AXL_ENABLED=true to serve get_score / get_peers queries over the Gensyn mesh.
# Build AXL: go build -o axl-node ./cmd/node/
# Generate key (macOS): /opt/homebrew/opt/openssl/bin/openssl genpkey -algorithm ed25519 -out private.pem
# Run node: ./axl-node --port 9002 --key-file private.pem
AXL_ENABLED=false
AXL_API=http://127.0.0.1:9002
COMPOSIA_FRONTEND_URL=http://localhost:3000
# AXL_NODE_KEY: 64-char hex public key from GET http://127.0.0.1:9002/topology → our_public_key
# After setting, run: pnpm ts-node packages/listener/src/axl-ens-setup.ts
AXL_NODE_KEY=
COMPOSIA_ENS_NAME=composia.eth
# Set to true to require senders to meet the on-chain verifications threshold (anti-Sybil)
# Leave false for testnet demos where agents have low verification counts
AXL_REQUIRE_THRESHOLD=false
